# Neon Serverless PostgreSQL pooled connection string
DATABASE_URL=postgres://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Access password to unlock the health tracker dashboard
HEALTH_ACCESS_PASSWORD=choose_a_strong_password_here

# Secret key used for signing session cookies (minimum 32 random characters recommended)
HEALTH_COOKIE_SECRET=generate_a_random_32_char_secret_string_here
